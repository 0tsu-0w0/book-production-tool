{
  "name": "kolophon",
  "version": "0.42.0",
  "description": "縦書き組版ソフト",
  "private": true,
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p .",
    "start": "tsc -p . && electron .",
    "test": "tsc -p . && node --test \"dist/test/**/*.test.js\"",
    "pdf": "tsc -p . && node dist/cli.js",
    "dist:win": "tsc -p . && electron-builder --win",
    "dist:mac": "tsc -p . && electron-builder --mac"
  },
  "dependencies": {
    "@mathjax/src": "^4.1.3",
    "@pdf-lib/fontkit": "^1.1.1",
    "harfbuzzjs": "^1.6.2",
    "hyphen": "^1.14.1",
    "jpeg-js": "^0.4.4",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0"
  },
  "devDependencies": {
    "@types/jpeg-js": "^0.3.0",
    "@types/node": "^26.6.3",
    "@types/pngjs": "^6.0.5",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "fast-xml-parser": "^5.11.2",
    "typescript": "^7.0.2"
  },
  "author": "Kolophon",
  "build": {
    "appId": "net.kolophon.app",
    "productName": "Kolophon",
    "copyright": "Kolophon",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "!dist/test/**",
      "!dist/cli.js",
      "!dist/**/*.map",
      "renderer/**/*",
      "assets/**/*",
      "package.json",
      "!**/*.map",
      "!**/*.d.ts",
      "!**/*.d.mts",
      "!**/*.md",
      "!**/LICENSE.md",
      "!node_modules/@mathjax/src/{mjs,ts,bundle,components,tsconfig}/**",
      "!node_modules/@mathjax/src/cjs/{a11y,ui}/**",
      "!node_modules/@mathjax/src/cjs/output/chtml/**",
      "!node_modules/@mathjax/src/cjs/output/chtml.js",
      "!node_modules/@mathjax/src/cjs/input/{mathml,asciimath}/**",
      "!node_modules/@mathjax/src/cjs/input/{mathml,asciimath}.js",
      "!node_modules/@mathjax/mathjax-newcm-font/{mjs,svg,chtml}/**",
      "!node_modules/@mathjax/mathjax-newcm-font/*.js",
      "!node_modules/@mathjax/mathjax-newcm-font/cjs/chtml/**",
      "!node_modules/@mathjax/mathjax-newcm-font/cjs/chtml.js",
      "!node_modules/speech-rule-engine/**",
      "!node_modules/hyphen/!(en-us|patterns|hyphen.js|export-contract.js|package.json|LICENSE)",
      "!node_modules/hyphen/patterns/!(en-us.js)",
      "!node_modules/mj-context-menu/**",
      "!node_modules/mhchemparser/**",
      "!node_modules/pdf-lib/{dist,es,ts3.4,src}/**",
      "!node_modules/pdf-lib/yarn.lock",
      "!node_modules/@pdf-lib/fontkit/{es,lib}/**",
      "!node_modules/@pdf-lib/fontkit/dist/{fontkit.es.js,fontkit.es.min.js,fontkit.umd.min.js}",
      "!node_modules/@pdf-lib/standard-fonts/dist/**",
      "!node_modules/@pdf-lib/upng/dist/**"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "kolo",
        "name": "Kolophon 文書",
        "description": "Kolophon 文書",
        "role": "Editor",
        "mimeType": "application/x-kolophon"
      },
      {
        "ext": "kolob",
        "name": "Kolophon ブック",
        "description": "Kolophon ブック",
        "role": "Editor",
        "mimeType": "application/x-kolophon-book"
      },
      {
        "ext": "kolophon",
        "name": "Kolophon 文書（前の拡張子）",
        "description": "Kolophon 文書（前の拡張子）",
        "role": "Editor",
        "mimeType": "application/x-kolophon"
      },
      {
        "ext": "kolbook",
        "name": "Kolophon ブック（前の拡張子）",
        "description": "Kolophon ブック（前の拡張子）",
        "role": "Editor",
        "mimeType": "application/x-kolophon-book"
      },
      {
        "ext": "tategumi",
        "name": "Kolophon 文書（旧 tategumi）",
        "description": "Kolophon 文書（旧 tategumi）",
        "role": "Editor",
        "mimeType": "application/x-tategumi"
      },
      {
        "ext": "tgbook",
        "name": "Kolophon ブック（旧 tategumi）",
        "description": "Kolophon ブック（旧 tategumi）",
        "role": "Editor",
        "mimeType": "application/x-tategumi-book"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Kolophon-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Kolophon"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "category": "public.app-category.productivity",
      "identity": "-",
      "artifactName": "Kolophon-${version}-mac.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "electronLanguages": [
      "ja",
      "en-US"
    ],
    "dmg": {
      "title": "Kolophon ${version}"
    },
    "publish": null
  }
}
